# Copy to server/.env and fill in. server/.env is git-ignored — never commit real values.

# --- Twilio (Console > Account > API keys & tokens) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# A Twilio phone number you own, or a verified outgoing caller ID, in E.164.
# Must NOT be the destination number.
TWILIO_FROM_NUMBER=+34XXXXXXXXX

# --- Public HTTPS URL that forwards to this server (port 3001). No trailing slash. ---
# Not needed with ./start.sh --cloudflare (the quick-tunnel URL is injected automatically).
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Number pre-filled in the form (Spain +34 or China +86). Default: +34 955 74 88 35 ---
# DEFAULT_DESTINATION_NUMBER=+86 138 0013 8000
# One-tap numbers shown under the phone field (comma-separated):
# SAVED_NUMBERS=+86 138 0013 8000, +1-707-555-0123, +33 6 39 98 12 34, +491711234567

# --- Voice (see https://www.twilio.com/docs/voice/twiml/say/text-speech) ---
# es-ES options: Polly.Lucia-Neural, Polly.Sergio-Neural, Polly.Lucia-Generative (beta), Polly.Conchita, Polly.Enrique
TTS_VOICE=Polly.Lucia-Neural
TTS_LANGUAGE=es-ES
# SSML prosody rate for Polly voices ("" disables). 90%-100% sounds clear on the phone.
TTS_RATE=95%

# --- Call flow timing ---
# silence after pick-up, for the recipient's "¿Diga?"
GREETING_PAUSE_SECONDS=2
# how long to wait for the recipient to start talking
GATHER_TIMEOUT_SECONDS=8
# silence that ends their answer (allows normal pauses)
SPEECH_TIMEOUT_SECONDS=3
# hard limit (max 120)
MAX_CALL_SECONDS=120
RING_TIMEOUT_SECONDS=30
# Optional Twilio speechModel (e.g. phone_call, googlev2_telephony). Empty = Twilio default.
SPEECH_MODEL=

# --- App security ---
# Password for the web UI. If empty, a temporary one is printed on server start.
APP_PASSWORD=
# Set to true when users reach the UI over HTTPS (e.g. through the tunnel).
COOKIE_SECURE=false
# Minutes a finished call's transcript stays in memory (never written to disk).
TRANSCRIPT_TTL_MINUTES=60

# --- Optional: ngrok tunnel container (./start.sh --tunnel) ---
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-subdomain.ngrok-free.app
